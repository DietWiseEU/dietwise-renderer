{
  "name": "dietwise-renderer",
  "version": "0.3.1",
  "description": "The web page renderer internal component of DietWise; it renders recipe pages on behalf of the mobile app",
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint",
    "format": "prettier . --write",
    "clean:html": "tsx scripts/clean-html-for-llm.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "async-mutex": "^0.5.0",
    "express": "^5.3.0",
    "linkedom": "^0.18.15",
    "playwright": "^1.65.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nabla/vite-plugin-eslint": "^3.0.1",
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.10",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.1",
    "schema-dts": "^2.1.0",
    "tsc-alias": "^1.9.11",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.2"
  }
}
